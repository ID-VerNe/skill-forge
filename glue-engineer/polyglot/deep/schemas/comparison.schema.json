{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparison Report",
  "description": "Structured comparison of multiple repository architecture reports",
  "type": "object",
  "required": ["status", "project", "candidate_count", "cloned_count", "clone_failures", "matrix", "comparisons", "ranking"],
  "properties": {
    "status": { "type": "string", "enum": ["complete", "data_incomplete"] },
    "project": { "type": "string" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "cloned_count": { "type": "integer", "minimum": 0 },
    "clone_failures": { "type": "array", "items": { "type": "object" } },
    "validation_failed": { "type": "boolean" },
    "validation_errors": { "type": "array", "items": { "type": "string" } },
    "warning": { "type": "string" },
    "error": { "type": "string" },
    "matrix": {
      "type": "object",
      "description": "Requirements coverage matrix",
      "properties": {
        "requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement": { "type": "string" }
            },
            "patternProperties": {
              "^[A-Za-z0-9_-]+$": { "type": "string", "enum": ["supported", "partial", "missing"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "language": { "type": "string" },
          "one_line_summary": { "type": "string" },
          "confidence": { "type": "number" },
          "known_gaps_summary": { "type": "string" },
          "evidence_count": { "type": "integer" },
          "core_module_count": { "type": "integer" },
          "key_type_count": { "type": "integer" },
          "platform_api_count": { "type": "integer" },
          "commit": { "type": "string" }
        }
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer" },
          "slug": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number" },
          "evidence_count": { "type": "integer" }
        }
      }
    }
  }
}
